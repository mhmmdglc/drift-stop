# Bu dosyayı .env olarak kopyala ve değerleri doldur.

# Migration script'leri için (scripts/db-migrate.js, scripts/seed-quotes.js).
# Supabase → Project Settings → Database → Connection string → Session pooler.
SUPABASE_PASSWORD=

# İstemci (Expo app) Supabase bağlantısı. EXPO_PUBLIC_ önekli değişkenler
# derlenen bundle'a gömülür, bu yüzden sadece public/anon değerler olmalı.
EXPO_PUBLIC_SUPABASE_URL=https://ftohdffebzhrthrpeuos.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat — Android public SDK key (RevenueCat dashboard → Project settings
# → Apps → [app] → Public API Key). Play Console entegre edilene kadar Test
# Store key'i ("test_...") kullan; canlıya çıkarken "goog_..." key'e geç.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# RevenueCat — iOS public SDK key ("appl_..."). Aynı yer: RevenueCat dashboard
# → Project settings → Apps → App Store app → Public API Key. Bu değer YOKKEN
# iOS'ta purchasesConfigured false kalır: paywall, Pro kartı ve bildirim
# limitleri hiç render edilmez, yani Pro bedavaya gider. iOS'a çıkmadan önce
# hem buraya hem `eas env:create` ile EAS bulut ortamına eklenmeli.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# Sentry crash reporting (opsiyonel). Boş bırakılırsa raporlama tamamen devre
# dışı kalır, uygulama normal çalışır. sentry.io'da proje oluşturup DSN'i
# buraya yapıştır: Settings → Projects → [proje] → Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=

# AdMob reklam birimi id'leri. Boş bırakılırsa yayın derlemesinde reklam GÖSTERİLMEZ
# (eskiden Google'ın test birimine düşülüyordu — gerçek kullanıcıya test reklamı
# göstermek politika ihlali). Geliştirme derlemeleri her zaman test birimi kullanır.
# ⚠️ Bu değerler derleme anında JS paketine gömülür: değiştirmek YENİ BUILD gerektirir.
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
