# Bu dosyayı .env olarak kopyala ve değerleri doldur.

# Migration script'leri için (scripts/db-migrate.js, scripts/seed-quotes.js).
# Supabase → Project Settings → Database → Connection string → Session pooler.
SUPABASE_PASSWORD=

# İstemci (Expo app) Supabase bağlantısı. EXPO_PUBLIC_ önekli değişkenler
# derlenen bundle'a gömülür, bu yüzden sadece public/anon değerler olmalı.
EXPO_PUBLIC_SUPABASE_URL=https://ftohdffebzhrthrpeuos.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat — Android public SDK key (RevenueCat dashboard → Project settings
# → Apps → [app] → Public API Key). Play Console entegre edilene kadar Test
# Store key'i ("test_...") kullan; canlıya çıkarken "goog_..." key'e geç.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# RevenueCat — iOS public SDK key ("appl_..."). Aynı yer: RevenueCat dashboard
# → Project settings → Apps → App Store app → Public API Key. Bu değer YOKKEN
# iOS'ta purchasesConfigured false kalır: paywall, Pro kartı ve bildirim
# limitleri hiç render edilmez, yani Pro bedavaya gider. iOS'a çıkmadan önce
# hem buraya hem `eas env:create` ile EAS bulut ortamına eklenmeli.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# Google ile giriş — OAuth istemci kimlikleri (Google Cloud → APIs & Services
# → Credentials). Bunlar sır değil: EXPO_PUBLIC_ oldukları için zaten her
# derlemenin JS paketine gömülüyorlar, o yüzden gerçek değerleriyle burada
# duruyorlar ve taze bir klon Google girişini yapılandırmadan kaybetmiyor.
# WEB kimliği Supabase'in doğruladığı "audience"; IOS kimliği olmadan iOS'ta
# yerel akış hiç başlamıyor.
# ⚠️ IOS kimliği `app.json`'daki Google eklentisinin `iosUrlScheme` değeriyle
# AYNI olmak zorunda (ters çevrilmiş hali). İkisi ayrışırsa iOS'ta giriş
# uygulamaya geri dönemez ve hiçbir yerde hata çıkmaz —
# `src/lib/__tests__/googleSignInConfig.test.ts` tam da bunu kolluyor.
# ⚠️ Bu değişkenler EAS bulut ortamına da (development/preview/production)
# eklenmeli; `.env` EAS derleyicilerine hiç ulaşmıyor.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=591923071526-4tmk3ook27po20c67nt8rcvrbp2qmhdo.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=591923071526-2le5mn1grsdie51f63afh8vkmm84pa13.apps.googleusercontent.com

# ANDROID kimliği uygulama tarafından hiç OKUNMUYOR — Android'de Google,
# eşleşmeyi paket adı + imza SHA-1'i üzerinden yapıyor. Buradaki tek işlevi
# Android'de Google düğmesinin gösterilip gösterilmeyeceğine karar vermek:
# BOŞ ise düğme hiç render edilmiyor. Google Cloud'da Android istemcisi
# yokken düğmeye basan herkes `DEVELOPER_ERROR` alıyor ve ekranda yalnızca
# genel hata satırını görüyor — kapalı test kanalındaki her testçi için.
# Android'i açmak bu yüzden kod değişikliği değil: istemciyi (paket
# `com.driftstop.app` + debug/upload/Play App Signing SHA-1'leri) oluştur,
# kimliği buraya VE EAS bulut ortamına yaz.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Sentry crash reporting (opsiyonel). Boş bırakılırsa raporlama tamamen devre
# dışı kalır, uygulama normal çalışır. sentry.io'da proje oluşturup DSN'i
# buraya yapıştır: Settings → Projects → [proje] → Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=

# AdMob reklam birimi id'leri. Boş bırakılırsa yayın derlemesinde reklam GÖSTERİLMEZ
# (eskiden Google'ın test birimine düşülüyordu — gerçek kullanıcıya test reklamı
# göstermek politika ihlali). Geliştirme derlemeleri her zaman test birimi kullanır.
# ⚠️ Bu değerler derleme anında JS paketine gömülür: değiştirmek YENİ BUILD gerektirir.
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
